{
  "expo": {
    "name": "AuraMystic - Tarot & Chiêm Tinh",
    "slug": "auramystic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#080514",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#080514",
          "image": "./assets/app-icon-foreground.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#080514",
            "image": "./assets/app-icon-foreground.png"
          }
        }
      ],
      "expo-image"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#080514",
        "foregroundImage": "./assets/app-icon-foreground.png",
        "monochromeImage": "./assets/app-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/app-favicon.png"
    }
  }
}
